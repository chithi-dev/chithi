{
    "name": "chithi-sdk",
    "version": "0.1.0",
    "description": "Chithi SDK — encrypted file upload/download via WASM C ABI (browser only)",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist/",
        "dist/chithi.wasm"
    ],
    "scripts": {
        "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=dist/index.js --external:*.wasm",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "esbuild": "^0.25.0",
        "typescript": "^5"
    },
    "engines": {
        "node": ">=18"
    },
    "allowScripts": {
        "esbuild@0.25.12": true
    }
}
