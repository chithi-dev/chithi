{
  "name": "chithi-sdk",
  "version": "0.1.0",
  "description": "Chithi SDK — encrypted file upload/download via WASM C ABI",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "dist/chithi.wasm"
  ],
  "scripts": {
    "build": "tsc && cp src/chithi.wasm dist/ 2>/dev/null || true",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}
