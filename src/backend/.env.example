# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=chithi

# Object storage (S3 / B2 / R2)
# S3_ENDPOINT_URL – the S3-compatible endpoint the backend writes to.
#   Backblaze B2: https://s3.us-west-004.backblazeb2.com
#   Cloudflare R2: https://<account>.r2.cloudflarestorage.com
#   Local RUSTFS:  http://localhost:9000
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# S3_CDN_URL – the public domain that serves chunk downloads (free egress).
#   Backblaze B2 CDN: https://f004.backblazeb2.com/file/<bucket>
#   Cloudflare R2:    https://<bucket>.cdn.cloudflare.net
#   Leave empty to fall back to presigned S3 URLs.
S3_CDN_URL=https://f004.backblazeb2.com/file/chithi

# S3 credentials (access key ID / secret from B2 or R2 console)
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=chithi

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
