{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignoreDeps": ["cryptography"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "timezone": "Asia/Dhaka",
  "schedule": [
    "at 10:00 on friday"
  ],
  "packageRules": [
    {
      "groupName": "all dependencies",
      "matchPackageNames": [
        "*"
      ]
    }
  ]
}
